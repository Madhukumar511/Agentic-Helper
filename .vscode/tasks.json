{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Agentic-Helper: Launch Browser (Port 9222)",
      "type": "shell",
      "command": "google-chrome --remote-debugging-port=9222 --user-data-dir=/tmp/agent_browser || chromium --remote-debugging-port=9222 --user-data-dir=/tmp/agent_browser",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Agentic-Helper: Start MCP Server",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/agentic-helper-mcp",
      "isBackground": false,
      "problemMatcher": []
    },
    {
      "label": "Agentic-Helper: Run Test Suite",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python -m unittest discover -s tests",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Agentic-Helper: Start REST Bridge Server",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/agentic-helper server --port 8000",
      "isBackground": true,
      "problemMatcher": []
    }
  ]
}
